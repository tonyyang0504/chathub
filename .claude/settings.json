{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": ".claude/hooks/protect-files.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": ".claude/hooks/block-commands.sh" }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": ".claude/hooks/protect-env-read.sh" }]
      }
    ]
  }
}
